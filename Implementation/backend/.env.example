# Copy this file to .env and fill in real values. Do NOT commit the real .env.
# IMPORTANT: the keys that previously lived here have been committed to git history
# and MUST be rotated/regenerated in their respective consoles before reuse.

# --- Database ---
# Either provide a full DATABASE_URL...
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
# ...or the individual parts below (used to build the URL if DATABASE_URL is unset)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ada_db
POSTGRES_USER=ada
POSTGRES_PASSWORD=change_me

# --- Auth ---
ADMIN_TOKEN=change_me
# Comma-separated allowlist of frontend origins for CORS, e.g.
# CORS_ALLOW_ORIGINS=https://your-frontend.example.com,http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# Tables to hide from the auto-generated API
AUTO_API_EXCLUDE=agent_publisher_affiliations,magazine_manual_map

# --- AI / Search keys (rotate before use) ---
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_CSE_API_KEY=your_google_cse_api_key
GOOGLE_CSE_CX=your_google_cse_cx
